# ===== 自研 SSO 服务配置 =====

# 对外签发地址(生产:https://sso.company.internal)
SSO_ISSUER=http://127.0.0.1:8091
SSO_PORT=8091
SSO_DATA_DIR=./data
SSO_KEYS_DIR=./keys
# 密钥退休窗口(小时):verifying 密钥超过该时长后移出 JWKS
SSO_KEY_RETIRE_AFTER_HOURS=2
SSO_CLIENTS_PATH=./clients.json

# ---- 客户端密钥(配合 clients.json 的 ${ENV:...} 占位) ----
SSO_SECRET_AGENT=change-me
SSO_SECRET_DASHBOARD=change-me
SSO_SECRET_MARKET=change-me
SSO_SECRET_RAG=change-me
SSO_SECRET_ROUTER=change-me
SSO_SECRET_ZHONGTAI_OA=change-me
# 仅 clients.example.json 的烟测客户端使用
SSO_SECRET_TEST_WEB=change-me

# 会话时长(小时)
SSO_SESSION_TTL_HOURS=8

# token 寿命(秒)
SSO_ACCESS_TOKEN_TTL_SECONDS=600
SSO_ID_TOKEN_TTL_SECONDS=600
# token-exchange 换取的 access_token 寿命(秒)
SSO_EXCHANGE_TTL=3600

# ---- 用户目录(二选一) ----
# 生产:OpenLDAP(钉钉同步 worker 维护)
#LDAP_URL=ldap://ldap:1389
#LDAP_BIND_DN=cn=sso-reader,ou=system,dc=company,dc=corp
#LDAP_BIND_PASSWORD=your-reader-password
#LDAP_BASE_DN=dc=company,dc=corp
# 开发/烟测:不配 LDAP_URL,使用 FILE_USERS_PATH 指定的 JSON 目录
FILE_USERS_PATH=./data/users.json

# ---- 钉钉扫码(企业内部应用,需通讯录只读权限) ----
DINGTALK_APP_KEY=your-app-key
DINGTALK_APP_SECRET=your-app-secret
DINGTALK_API_BASE=https://api.dingtalk.com
DINGTALK_OAPI_BASE=https://oapi.dingtalk.com
DINGTALK_LOGIN_BASE=https://login.dingtalk.com
# 钉钉回调地址:必须与钉钉后台"回流域名"配置一致
SSO_DINGTALK_REDIRECT_URI=http://127.0.0.1:8091/dingtalk/callback

# 登录/改密表单 CSRF 签名密钥(可选;未设置时用进程级随机值,重启后旧表单 token 失效)
#SSO_CSRF_SECRET=change-me

# 调试日志(生产留空)
SSO_DEBUG=

# 是否信任反向代理传来的真实客户端 IP 头(x-real-ip/x-forwarded-for)
# 仅当服务不直接对外暴露时开启(45 生产经 nginx 转发 8091, 建议 true);直连暴露时保持关闭防伪造
#SSO_TRUST_PROXY=false

# ---- 邮件发送(SMTP, 可选; 不配置则自助「忘记密码」不可用, 不影响 SSO 启动) ----
#SSO_SMTP_HOST=smtp.qiye.aliyun.com
#SSO_SMTP_PORT=465
# 465 走 SMTPS 置 true(默认); 587/25 走 STARTTLS 置 false
#SSO_SMTP_SECURE=true
#SSO_SMTP_USERNAME=sso@company.com
#SSO_SMTP_PASSWORD=change-me
# 发件人显示名(默认「零号员工」)
#SSO_SMTP_FROM_NAME=零号员工
# 发件地址, 默认与 SSO_SMTP_USERNAME 相同
#SSO_SMTP_FROM=sso@company.com
# 自助重置验证码有效期(秒), 默认 600(10 分钟)
#SSO_RESET_CODE_TTL_SECONDS=600
